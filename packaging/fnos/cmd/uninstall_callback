#!/bin/bash
# 卸载后回调：停止并移除容器。数据目录（曲库、数据库、网盘配置）保留，
# 重装后可继续使用；如需彻底清除请手动删除应用数据目录。

APP_ROOT="/var/apps/ktv-home-cloud"
DOCKER_DIR="${APP_ROOT}/target/docker"
export TRIM_PKGVAR="${TRIM_PKGVAR:-${APP_ROOT}/var}"

if [ -f "${DOCKER_DIR}/docker-compose.yaml" ]; then
  set -a
  [ -f "${DOCKER_DIR}/.env" ] && . "${DOCKER_DIR}/.env"
  set +a
  docker compose -f "${DOCKER_DIR}/docker-compose.yaml" --project-name ktv-home-cloud down 2>/dev/null || true
fi
exit 0
