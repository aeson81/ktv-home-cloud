#!/bin/bash
# 安装后回调：载入内置 Docker 镜像 -> 写安装日志。
# 注意：
# - 容器由飞牛通过 config/resource 的 docker-project 声明自动启停，
#   本脚本不执行 docker compose，也不在此时操作容器。
# - 密码直接硬编码在 docker-compose.yaml 中（飞牛不保证加载 .env，
#   参考官方做法：配置硬编码）。任何一步失败都不应导致安装整体失败。

APP_ROOT="/var/apps/ktv-home-cloud"
TARGET="${APP_ROOT}/target"
VAR_DIR="${TRIM_PKGVAR:-${APP_ROOT}/var}"
LOG="${TRIM_TEMP_LOGFILE:-/tmp/ktv-home-cloud-install.log}"
ALIST_DEFAULT_PW="KtvAlist2026ChangeMe"

mkdir -p "$VAR_DIR"

# 1. 载入安装包内置的 Docker 镜像（安装时无需联网下载）。
for tar in "${TARGET}"/app/images/*.tar; do
  [ -e "$tar" ] || continue
  if docker load -i "$tar" >/dev/null 2>&1; then
    echo "已载入镜像：$(basename "$tar")"
  else
    echo "镜像载入失败：$(basename "$tar")，可在 NAS 上手动执行 docker load -i \"$tar\""
  fi
done >>"$LOG" 2>&1

# 2. 镜像已载入，删除包内副本释放空间（约 380MB）。
rm -f "${TARGET}"/app/images/*.tar

# 3. 安装说明（飞牛安装界面会展示此日志）。
{
  echo "家庭KTV（含网盘）安装完成，飞牛正在后台启动容器，约 1-2 分钟后可用。"
  echo ""
  echo "手机点歌：http://<飞牛IP>:8080/m"
  echo "管理后台：http://<飞牛IP>:8080/m/admin"
  echo "alist 网盘管理：http://<飞牛IP>:5244（账号 admin）"
  echo "alist 管理员密码：${ALIST_DEFAULT_PW}"
  echo "  （首次登录后请在 alist 网页右下角头像 -> 修改密码）"
  echo ""
  echo "网盘挂载步骤："
  echo "1. 用上面的账号密码登录 alist，添加百度网盘 / OneDrive / 115（Cookie 等只填在 alist 网页里）。"
  echo "2. 回到 KTV 管理后台，点「扫描源路径」，网盘歌曲会自动复制入库（网盘源只读，不会删除网盘文件）。"
  echo ""
  echo "注意：本应用仅适用于可信局域网，请勿把 8080/5244 端口暴露到公网。"
} >> "$LOG" 2>&1

exit 0
