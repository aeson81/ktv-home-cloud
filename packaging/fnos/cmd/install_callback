#!/bin/bash
# 安装后回调：写安装日志。
# 注意：
# - 容器由飞牛通过 config/resource 的 docker-project 声明自动启停，
#   本脚本不执行 docker compose，也不在此时操作容器。
# - 镜像从 ghcr.io / docker.m.daocloud.io 拉取，无需打包在安装包内。
# - 密码直接硬编码在 docker-compose.yaml 中（飞牛不保证加载 .env）。
# 任何一步失败都不应导致安装整体失败。

VAR_DIR="${TRIM_PKGVAR:-/var/apps/ktv-home-cloud/var}"
LOG="${TRIM_TEMP_LOGFILE:-/tmp/ktv-home-cloud-install.log}"
# fpk 所在目录（compose 文件位置）
APP_DIR="$(cd "$(dirname "$0")/../app" && pwd)"
COMPOSE_FILE="$APP_DIR/docker/docker-compose.yaml"

mkdir -p "$VAR_DIR"

# 读取向导参数（飞牛把 wizard 里定义的 key 作为环境变量传入）。
# 兼容多种可能的前缀。
get_wizard_value() {
  local key="$1"
  local default="$2"
  for prefix in "" "WIZARD_" "TRIM_WIZARD_"; do
    local var="${prefix}${key}"
    local val="${!var:-}"
    if [ -n "$val" ]; then
      echo "$val"
      return
    fi
  done
  echo "$default"
}

KTV_PORT="$(get_wizard_value "KTV_PORT" "8080")"
SOURCE_MUSIC_PATH="$(get_wizard_value "SOURCE_MUSIC_PATH" "")"
# 115 Cookie 也可通过向导传入（可选）。
WIZARD_115_COOKIE="$(get_wizard_value "KTV_115_COOKIE" "")"

# 把端口写入 compose 文件（替换占位符）。
if [ -f "$COMPOSE_FILE" ]; then
  # KTV 端口：替换 "8080:8080/tcp" 中的主机端口
  sed -i "s/\"8080:8080\/tcp\"/\"${KTV_PORT}:8080\/tcp\"/" "$COMPOSE_FILE" 2>>"$LOG" || true
  echo "端口配置：KTV=${KTV_PORT}" >> "$LOG"
  # 如果向导提供了 115 Cookie，写入 compose。
  if [ -n "$WIZARD_115_COOKIE" ]; then
    # 转义 Cookie 中的特殊字符（& / \），避免 sed 出错。
    ESCAPED="$(printf '%s' "$WIZARD_115_COOKIE" | sed 's/[\/&]/\\&/g')"
    sed -i "s/^\(\s*KTV_115_COOKIE:\s*\)\"\"/\1\"$ESCAPED\"/" "$COMPOSE_FILE" 2>>"$LOG" || true
    echo "已配置 115 Cookie" >> "$LOG"
  fi
fi

# 自定义源目录：如果向导里填写了，保存到配置文件并立即挂载。
# （也兼容旧版手动创建的 custom-source.conf）
CUSTOM_CONF="$VAR_DIR/custom-source.conf"
if [ -n "$SOURCE_MUSIC_PATH" ] && [ -d "$SOURCE_MUSIC_PATH" ]; then
  echo "$SOURCE_MUSIC_PATH" > "$CUSTOM_CONF"
  echo "已保存自定义源目录：$SOURCE_MUSIC_PATH" >> "$LOG"
fi

# 自动恢复自定义源目录的 bind 挂载（解决 fpk 重装后手动 bind 丢失的问题）。
if [ -f "$CUSTOM_CONF" ]; then
  CUSTOM_SRC="$(head -n 1 "$CUSTOM_CONF" | tr -d '\r\n')"
  if [ -n "$CUSTOM_SRC" ] && [ -d "$CUSTOM_SRC" ]; then
    mkdir -p "$VAR_DIR/source-music"
    if ! mountpoint -q "$VAR_DIR/source-music" 2>/dev/null; then
      mount --bind "$CUSTOM_SRC" "$VAR_DIR/source-music" 2>>"$LOG" && \
        echo "已自动挂载自定义源目录：$CUSTOM_SRC -> $VAR_DIR/source-music" >> "$LOG" || \
        echo "警告：自动挂载自定义源目录失败：$CUSTOM_SRC" >> "$LOG"
      # 写入 fstab 保证重启后自动挂载
      grep -q "$VAR_DIR/source-music" /etc/fstab 2>/dev/null || \
        echo "$CUSTOM_SRC $VAR_DIR/source-music none bind 0 0" >> /etc/fstab 2>>"$LOG" || true
    fi
  fi
fi

# 安装说明（飞牛安装界面会展示此日志）。
{
  echo "K无限安装完成，飞牛正在后台拉取镜像并启动容器，约 2-5 分钟后可用。"
  echo ""
  echo "手机点歌：http://<飞牛IP>:${KTV_PORT}/m"
  echo "管理后台：http://<飞牛IP>:${KTV_PORT}/m/admin"
  echo ""
  echo "115 网盘挂载（可选）："
  echo "1. 在浏览器登录 115.com，按 F12 打开开发者工具，在网络请求中找到 Cookie，"
  echo "   复制 UID、CID、SEID 三个值，拼成：UID=xxx; CID=xxx; SEID=xxx"
  echo "2. SSH 到 NAS，编辑 /vol2/@appdata/ktv-home-cloud/docker/docker-compose.yaml，"
  echo "   找到 KTV_115_COOKIE 一行，填入你的 Cookie 后保存。"
  echo "3. 在飞牛 Docker 里重启 ktv-app 容器，115 会挂载到 /cloud-music/115。"
  echo "4. 回到 KTV 管理后台，点「扫描源路径」，网盘歌曲会自动复制入库（只读，不会删除网盘文件）。"
  echo "   注意：115 Cookie 会过期，失效后需重新获取并更新。"
  echo ""
  echo "注意：本应用仅适用于可信局域网，请勿把 ${KTV_PORT} 端口暴露到公网。"
} >> "$LOG" 2>&1

exit 0
